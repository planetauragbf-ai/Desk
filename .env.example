# Copier ce fichier vers .env (ou définir ces variables dans Cloudflare Pages / GitHub Secrets).
# Sans ces variables, l'application démarre en MODE DÉMO (données locales dans le navigateur).

# URL du projet Supabase (Settings > API)
VITE_SUPABASE_URL=

# Clé anonyme publique Supabase (Settings > API > anon public)
VITE_SUPABASE_ANON_KEY=
